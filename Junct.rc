#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    JUNCT_VER_MAJOR, JUNCT_VER_MINOR, JUNCT_VER_PATCH, JUNCT_VER_BUILD
 PRODUCTVERSION JUNCT_VER_MAJOR, JUNCT_VER_MINOR, JUNCT_VER_PATCH, JUNCT_VER_BUILD
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Junct"
            VALUE "FileDescription",  "Junct - Windows Explorer shell extension"
            VALUE "FileVersion",      JUNCT_VER_STRING
            VALUE "InternalName",     "Junct"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "Junct.dll"
            VALUE "ProductName",      "Junct"
            VALUE "ProductVersion",   JUNCT_VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
